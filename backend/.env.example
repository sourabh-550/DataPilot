# Copy to backend/.env and fill in. Never commit the real .env.

# Groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
# low / medium / high for reasoning models; leave empty for a non-reasoning model
GROQ_REASONING_EFFORT=low

# Postgres (Supabase). Leave unset to use a local SQLite file.
DATABASE_URL=postgresql://postgres:your-password@your-host:5432/postgres

# Supabase (JWT verification via JWKS, and Storage for uploaded files)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=datapilot-uploads
