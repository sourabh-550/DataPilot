# Copy to frontend/.env and fill in. These values ship in the browser bundle (public).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Must end with /api. If unset, the app falls back to the deployed backend.
VITE_API_URL=http://localhost:8000/api
